#!/bin/sh
# secrets: one command for secrets from 1Password. Subcommands: setup, run, import, add, status.

secrets_dir=$(realpath "$0") || exit 1
secrets_dir=${secrets_dir%/*}
# shellcheck source=../lib/common.sh
. "$secrets_dir/../lib/common.sh"

secrets_cmd_run() {
  _ru_stage=''
  _ru_guarded=0
  while [ $# -gt 0 ]; do
    case $1 in
      --stage)
        [ $# -ge 2 ] || secrets_die "--stage needs a name"
        secrets_check stage "$2"
        _ru_stage=$2
        shift 2 ;;
      --guarded) _ru_guarded=1; shift ;;
      --) shift; break ;;
      *) secrets_die "unknown option \"$1\". Use: secrets run [--stage NAME] [--guarded] -- CMD" ;;
    esac
  done
  [ $# -gt 0 ] || secrets_die "no command. Use: secrets run [--stage NAME] [--guarded] -- CMD"

  _ru_root=$(secrets_repo_root) || exit 1
  _ru_files=$(secrets_refs_file "$_ru_stage" 0)
  [ "$_ru_guarded" != 1 ] || _ru_files="$_ru_files $(secrets_refs_file "$_ru_stage" 1)"
  _ru_refs=''
  for _ru_f in $_ru_files; do
    _ru_part=$(secrets_refs_read "$_ru_root/$_ru_f") || exit 1
    _ru_tag=''
    [ "$_ru_f" = "$(secrets_refs_file "$_ru_stage" 1)" ] && _ru_tag=g
    while IFS= read -r _ru_line; do
      [ -z "$_ru_line" ] || _ru_refs="$_ru_refs$_ru_line$secrets_tab$_ru_tag
"
    done <<EOF
$_ru_part
EOF
  done
  _ru_project=$(secrets_project "$_ru_root") || exit 1
  _ru_token=$(secrets_token "$_ru_project") || exit 1

  _ru_dir=$(mktemp -d "${TMPDIR:-/tmp}/secrets.XXXXXX") || secrets_die "cannot make a temp folder in ${TMPDIR:-/tmp}"
  trap 'rm -rf "$_ru_dir"' EXIT
  trap 'rm -rf "$_ru_dir"; exit 130' INT
  trap 'rm -rf "$_ru_dir"; exit 143' TERM

  # shellcheck disable=SC2016 # the wrapper runs in a child shell, which expands it
  set -- -- sh -c ': > "$1"; shift; exec env -u OP_SERVICE_ACCOUNT_TOKEN "$@"' secrets-run "$_ru_dir/started" "$@"
  for _ru_f in $_ru_files; do
    set -- --env-file "$_ru_root/$_ru_f" "$@"
  done
  OP_SERVICE_ACCOUNT_TOKEN=$_ru_token
  export OP_SERVICE_ACCOUNT_TOKEN
  op run "$@"
  _ru_rc=$?
  [ "$_ru_rc" -ne 0 ] && [ ! -e "$_ru_dir/started" ] || exit "$_ru_rc"
  secrets_run_diagnose "$_ru_refs" "$_ru_project" "$_ru_dir" "$_ru_rc"
}

# secrets_run_diagnose REFS PROJECT DIR RC: names every ref that op run could not read, then exits 1.
secrets_run_diagnose() {
  _rd_bad=''
  mkdir "$3/titles" || exit 1
  while IFS=$secrets_tab read -r _rd_name _rd_vault _rd_title _rd_guarded; do
    [ -n "$_rd_name" ] || continue
    _rd_cache=$3/titles/$(secrets_lower "$_rd_vault")
    [ -f "$_rd_cache" ] || secrets_titles "$_rd_vault" "$2" > "$_rd_cache" || exit 1
    _rd_n=$(grep -Fxc -- "$_rd_title" "$_rd_cache")
    if [ "$_rd_n" -eq 0 ]; then
      _rd_bad="${_rd_bad}secrets: cannot read $_rd_name (item $_rd_title in vault $_rd_vault)
"
      if [ -n "$_rd_guarded" ]; then
        _rd_bad="${_rd_bad}secrets:   ask the owner to move $_rd_title from $2-guarded to $2
"
      fi
    elif [ "$_rd_n" -gt 1 ]; then
      _rd_bad="${_rd_bad}secrets: more than one item is titled $_rd_title in vault $_rd_vault. Keep one.
"
    fi
  done <<EOF
$1
EOF
  [ -n "$_rd_bad" ] || secrets_die "op run stopped before the command started (exit $4)"
  printf '%s' "$_rd_bad" >&2
  exit 1
}

# secrets_guarded_refs ROOT: NAME<TAB>VAULT<TAB>TITLE for every line in the guarded refs files
# of ROOT, with VAULT in lower case.
secrets_guarded_refs() {
  for _gr_file in "$1/.secrets-refs.guarded" "$1"/.secrets-refs.*.guarded; do
    [ -f "$_gr_file" ] || continue
    _gr_refs=$(secrets_refs_read "$_gr_file") || exit 1
    while IFS=$secrets_tab read -r _gr_name _gr_vault _gr_title; do
      [ -z "$_gr_name" ] ||
        printf '%s\t%s\t%s\n' "$_gr_name" "$(secrets_lower "$_gr_vault")" "$_gr_title"
    done <<EOF
$_gr_refs
EOF
  done
}

# secrets_refuse_guarded GUARDED-REFS PROJECT NAME TITLE: dies when a guarded ref has NAME, or
# points at TITLE in the project vault, which an approved guarded item can be in.
secrets_refuse_guarded() {
  while IFS=$secrets_tab read -r _rg_name _rg_vault _rg_title; do
    if [ "$_rg_name" = "$3" ] || { [ "$_rg_vault" = "$2" ] && [ "$_rg_title" = "$4" ]; }; then
      secrets_die "$3 is a guarded secret. Ask the owner to change it in 1Password."
    fi
  done <<EOF
$1
EOF
}

# secrets_title_exists TITLES TITLE VAULT: prints 1 when TITLES holds TITLE once, 0 when not,
# and dies when it holds TITLE more than once.
secrets_title_exists() {
  _te_n=$(printf '%s\n' "$1" | grep -Fxc -- "$2")
  [ "$_te_n" -le 1 ] || secrets_die "more than one item is titled $2 in vault $3. Keep one."
  printf '%s\n' "$_te_n"
}

secrets_cmd_import() {
  _im_names_only=''
  while [ $# -gt 0 ]; do
    case $1 in
      --names-only) _im_names_only=1; shift ;;
      --) shift; break ;;
      -*) secrets_die "unknown option \"$1\". Use: secrets import [--names-only] FILE[:STAGE]..." ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || secrets_die "no env file. Use: secrets import [--names-only] FILE[:STAGE]..."
  secrets_env_check "$@"
  if [ -n "$_im_names_only" ]; then
    for _im_spec do
      _im_stage=$(secrets_stage_of "$_im_spec") || exit 1
      secrets_env_each "$(secrets_spec_file "$_im_spec")" secrets_import_show
    done
    return 0
  fi

  _im_root=$(secrets_repo_root) || exit 1
  _im_project=$(secrets_project "$_im_root") || exit 1
  _im_guarded=$(secrets_guarded_refs "$_im_root") || exit 1
  _im_plan=''
  for _im_spec do
    _im_file=$(secrets_spec_file "$_im_spec")
    _im_stage=$(secrets_stage_of "$_im_spec") || exit 1
    _im_count=0
    secrets_env_each "$_im_file" secrets_import_plan
    [ "$_im_count" -le 50 ] ||
      secrets_die "$_im_file has $_im_count names. import takes at most 50; use secrets setup --import."
  done
  _im_token=$(secrets_token "$_im_project") || exit 1
  OP_SERVICE_ACCOUNT_TOKEN=$_im_token
  export OP_SERVICE_ACCOUNT_TOKEN
  _im_titles=$(secrets_titles "$_im_project") || exit 1
  while IFS= read -r _im_title; do
    [ -z "$_im_title" ] || secrets_title_exists "$_im_titles" "$_im_title" "$_im_project" > /dev/null
  done <<EOF
$_im_plan
EOF

  _im_stored=''
  _im_skipped=''
  for _im_spec do
    _im_stage=$(secrets_stage_of "$_im_spec") || exit 1
    secrets_env_each "$(secrets_spec_file "$_im_spec")" secrets_import_put
  done
  printf 'secrets: stored in %s: %s%s\n' "$_im_project" "${_im_stored:-nothing}" \
    "${_im_skipped:+. Skipped (empty value): $_im_skipped}"
}

secrets_import_show() { # NAME VALUE
  if [ -z "$2" ]; then
    printf '%s  (empty, skipped)\n' "$1"
  else
    printf '%s  %s%s\n' "$1" "${_im_stage:-default}" "$(secrets_short_mark "$2")"
  fi
}

secrets_import_plan() { # NAME VALUE
  [ -n "$2" ] || return 0
  _ipl_title=$1${_im_stage:+.$_im_stage}
  secrets_refuse_guarded "$_im_guarded" "$_im_project" "$1" "$_ipl_title"
  _im_count=$((_im_count + 1))
  _im_plan="$_im_plan$_ipl_title
"
}

secrets_import_put() { # NAME VALUE
  if [ -z "$2" ]; then
    _im_skipped=${_im_skipped:+$_im_skipped, }$1
    return 0
  fi
  _iw_title=$1${_im_stage:+.$_im_stage}
  _iw_n=$(secrets_title_exists "$_im_titles" "$_iw_title" "$_im_project") || exit 1
  printf '%s' "$2" | secrets_item_put "$_im_project" "$_iw_title" '' "$_iw_n" || exit 1
  secrets_refs_set "$_im_root/$(secrets_refs_file "$_im_stage" 0)" "$1" "$_im_project" "$_iw_title"
  _im_stored=${_im_stored:+$_im_stored, }$_iw_title
}

secrets_cmd_add() {
  _ad_name=''
  _ad_stage=''
  while [ $# -gt 0 ]; do
    case $1 in
      --stage)
        [ $# -ge 2 ] || secrets_die "--stage needs a name"
        secrets_check stage "$2"
        _ad_stage=$2
        shift 2 ;;
      -*) secrets_die "unknown option \"$1\". Use: secrets add NAME [--stage NAME]" ;;
      *)
        [ -z "$_ad_name" ] || secrets_die "one name only. Use: secrets add NAME [--stage NAME]"
        _ad_name=$1
        shift ;;
    esac
  done
  [ -n "$_ad_name" ] || secrets_die "no name. Use: secrets add NAME [--stage NAME]"
  secrets_check name "$_ad_name"
  _ad_root=$(secrets_repo_root) || exit 1
  _ad_project=$(secrets_project "$_ad_root") || exit 1
  _ad_title=$_ad_name${_ad_stage:+.$_ad_stage}
  _ad_guarded=$(secrets_guarded_refs "$_ad_root") || exit 1
  secrets_refuse_guarded "$_ad_guarded" "$_ad_project" "$_ad_name" "$_ad_title"
  _ad_token=$(secrets_token "$_ad_project") || exit 1

  if [ -t 0 ]; then
    _ad_tty=$(stty -g)
    trap 'stty "$_ad_tty"' EXIT
    trap 'stty "$_ad_tty"; exit 130' INT
    trap 'stty "$_ad_tty"; exit 143' TERM
    printf 'secrets: value for %s (hidden): ' "$_ad_name" >&2
    stty -echo
    IFS= read -r _ad_value
    stty "$_ad_tty"
    trap - EXIT INT TERM
    printf '\n' >&2
  else
    _ad_value=$(cat)
  fi
  [ -n "$_ad_value" ] || secrets_die "the value for $_ad_name is empty. Nothing was stored."

  OP_SERVICE_ACCOUNT_TOKEN=$_ad_token
  export OP_SERVICE_ACCOUNT_TOKEN
  _ad_titles=$(secrets_titles "$_ad_project") || exit 1
  _ad_n=$(secrets_title_exists "$_ad_titles" "$_ad_title" "$_ad_project") || exit 1
  printf '%s' "$_ad_value" | secrets_item_put "$_ad_project" "$_ad_title" '' "$_ad_n" || exit 1
  secrets_refs_set "$_ad_root/$(secrets_refs_file "$_ad_stage" 0)" "$_ad_name" "$_ad_project" "$_ad_title"
  printf 'secrets: stored in %s: %s\n' "$_ad_project" "$_ad_title"
}

# secrets_quote ARG: ARG in single quotes for a shell, with each ' written as '\''.
secrets_quote() {
  _qt_out=''
  _qt_rest=$1
  while :; do
    case $_qt_rest in
      *\'*) _qt_out=$_qt_out${_qt_rest%%\'*}"'\\''"; _qt_rest=${_qt_rest#*\'} ;;
      *) break ;;
    esac
  done
  printf "'%s'\n" "$_qt_out$_qt_rest"
}

secrets_setup_name() { # NAME VALUE
  _su_names="$_su_names$1
"
}

secrets_cmd_setup() {
  _su_usage='Use: secrets setup PROJECT [--import FILE[:STAGE]]... [--guard NAME,...] [--renew]'
  [ $# -gt 0 ] || secrets_die "no project. $_su_usage"
  case $1 in -*) secrets_die "no project. $_su_usage" ;; esac
  secrets_check project "$1"
  _su_project=$1
  shift
  _su_flags=''
  _su_specs=''
  _su_guards=''
  while [ $# -gt 0 ]; do
    case $1 in
      --import)
        [ $# -ge 2 ] || secrets_die "--import needs a file. $_su_usage"
        _su_file=$(secrets_spec_file "$2")
        case $2 in *:*) _su_suffix=:${2##*:} ;; *) _su_suffix='' ;; esac
        case $_su_file in /*) ;; *) _su_file=$PWD/$_su_file ;; esac
        _su_specs="$_su_specs
$_su_file$_su_suffix"
        _su_flags="$_su_flags
--import
$_su_file$_su_suffix"
        shift 2 ;;
      --guard)
        [ $# -ge 2 ] || secrets_die "--guard needs names. $_su_usage"
        _su_guards="$_su_guards
$2"
        _su_flags="$_su_flags
--guard
$2"
        shift 2 ;;
      --renew) _su_flags="$_su_flags
--renew"; shift ;;
      *) secrets_die "unknown option \"$1\". $_su_usage" ;;
    esac
  done

  _su_names=''
  if [ -n "$_su_specs" ]; then
    IFS='
'
    # shellcheck disable=SC2086 # one word per line, no globbing
    set -f -- $_su_specs
    unset IFS
    set +f
    secrets_env_check "$@"
    for _su_spec do
      secrets_env_each "$(secrets_spec_file "$_su_spec")" secrets_setup_name
    done
  fi
  IFS='
'
  # shellcheck disable=SC2086 # one word per line, no globbing
  set -f -- $_su_guards
  unset IFS
  set +f
  for _su_list do
    IFS=,
    # shellcheck disable=SC2086 # split at commas on purpose
    set -f -- $_su_list
    unset IFS
    set +f
    for _su_name do
      secrets_check name "$_su_name"
      case "
$_su_names" in
        *"
$_su_name
"*) ;;
        *) secrets_die "$_su_name is in no import file, so it cannot be guarded." ;;
      esac
    done
  done

  _su_wait=${SECRETS_SETUP_WAIT:-900}
  case $_su_wait in '' | *[!0123456789]*) secrets_die "SECRETS_SETUP_WAIT must be a number of seconds" ;; esac
  _su_root=$(secrets_repo_root) || exit 1
  _su_dir=$(mktemp -d "${TMPDIR:-/tmp}/secrets-setup.XXXXXX") || secrets_die "cannot make a temp folder in ${TMPDIR:-/tmp}"
  trap 'rm -rf "$_su_dir"' EXIT
  trap 'rm -rf "$_su_dir"; exit 130' INT
  trap 'rm -rf "$_su_dir"; exit 143' TERM
  chmod 700 "$_su_dir" || exit 1
  _su_result=$_su_dir/result

  _su_line="exec sh $(secrets_quote "$secrets_dir/../libexec/setup-window.sh") $(secrets_quote "$_su_root") $(secrets_quote "$_su_result") $(secrets_quote "$_su_project")"
  IFS='
'
  # shellcheck disable=SC2086 # one word per line, no globbing
  set -f -- $_su_flags
  unset IFS
  set +f
  for _su_arg do
    _su_line="$_su_line $(secrets_quote "$_su_arg")"
  done
  printf '#!/bin/sh\n%s\n' "$_su_line" > "$_su_dir/launch.command" || exit 1
  chmod 700 "$_su_dir/launch.command" || exit 1
  open -a Terminal "$_su_dir/launch.command" || secrets_die "cannot open a Terminal window"

  _su_elapsed=0
  while [ ! -e "$_su_result" ]; do
    [ "$_su_elapsed" -lt "$_su_wait" ] || secrets_die "the setup window gave no result in $_su_wait seconds"
    sleep 2
    _su_elapsed=$((_su_elapsed + 2))
  done
  IFS= read -r _su_status < "$_su_result"
  if [ "$_su_status" = ok ]; then
    _su_n=0
    while IFS= read -r _su_text || [ -n "$_su_text" ]; do
      _su_n=$((_su_n + 1))
      [ "$_su_n" -eq 1 ] || printf '%s\n' "$_su_text"
    done < "$_su_result"
    return 0
  fi
  while IFS= read -r _su_text || [ -n "$_su_text" ]; do
    printf '%s\n' "$_su_text" >&2
  done < "$_su_result"
  exit 1
}

case ${1-} in
  setup | run | import | add | status)
    secrets_sub=$1
    shift
    "secrets_cmd_$secrets_sub" "$@" ;;
  *) secrets_die "unknown subcommand \"${1-}\". Use: setup, run, import, add, status" ;;
esac
