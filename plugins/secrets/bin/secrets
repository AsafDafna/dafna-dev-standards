#!/bin/sh
# secrets: one command for secrets from 1Password. Subcommands: setup, run, import, add, status.

# A trace (sh -x, or SHELLOPTS=xtrace) would print every value and the token.
set +x
secrets_dir=$(realpath "$0") || exit 1
secrets_dir=${secrets_dir%/*}
# shellcheck source=../lib/common.sh
. "$secrets_dir/../lib/common.sh"

secrets_cmd_run() {
  _ru_stage=''
  _ru_guarded=0
  while [ $# -gt 0 ]; do
    case $1 in
      --stage)
        [ $# -ge 2 ] || secrets_die "--stage needs a name"
        secrets_check stage "$2"
        _ru_stage=$2
        shift 2 ;;
      --guarded) _ru_guarded=1; shift ;;
      --) shift; break ;;
      *) secrets_die "unknown option \"$1\". Use: secrets run [--stage NAME] [--guarded] -- CMD" ;;
    esac
  done
  [ $# -gt 0 ] || secrets_die "no command. Use: secrets run [--stage NAME] [--guarded] -- CMD"

  _ru_root=$(secrets_repo_root) || exit 1
  _ru_files=$(secrets_refs_file "$_ru_stage" 0)
  [ "$_ru_guarded" != 1 ] || _ru_files="$_ru_files $(secrets_refs_file "$_ru_stage" 1)"
  _ru_refs=''
  for _ru_f in $_ru_files; do
    _ru_part=$(secrets_refs_read "$_ru_root/$_ru_f") || exit 1
    _ru_refs="$_ru_refs$_ru_part
"
  done
  _ru_project=$(secrets_project "$_ru_root") || exit 1
  _ru_token=$(secrets_token "$_ru_project") || exit 1

  _ru_dir=$(mktemp -d "${TMPDIR:-/tmp}/secrets.XXXXXX") || secrets_die "cannot make a temp folder in ${TMPDIR:-/tmp}"
  trap 'rm -rf "$_ru_dir"' EXIT
  trap 'rm -rf "$_ru_dir"; exit 130' INT
  trap 'rm -rf "$_ru_dir"; exit 143' TERM

  # shellcheck disable=SC2016 # the wrapper runs in a child shell, which expands it
  set -- -- sh -c ': > "$1"; shift; exec env -u OP_SERVICE_ACCOUNT_TOKEN "$@"' secrets-run "$_ru_dir/started" "$@"
  for _ru_f in $_ru_files; do
    set -- --env-file "$_ru_root/$_ru_f" "$@"
  done
  OP_SERVICE_ACCOUNT_TOKEN=$_ru_token
  export OP_SERVICE_ACCOUNT_TOKEN
  op run "$@"
  _ru_rc=$?
  [ "$_ru_rc" -ne 0 ] && [ ! -e "$_ru_dir/started" ] || exit "$_ru_rc"
  secrets_run_diagnose "$_ru_refs" "$_ru_project" "$_ru_dir" "$_ru_rc"
}

# secrets_run_diagnose REFS PROJECT DIR RC: names every ref that op run could not read, then exits 1.
secrets_run_diagnose() {
  _rd_bad=''
  mkdir "$3/titles" || exit 1
  while IFS=$secrets_tab read -r _rd_name _rd_vault _rd_title; do
    [ -n "$_rd_name" ] || continue
    _rd_cache=$3/titles/$(secrets_lower "$_rd_vault")
    [ -f "$_rd_cache" ] || secrets_titles "$_rd_vault" "$2" > "$_rd_cache" || exit 1
    _rd_n=$(secrets_title_count "$_rd_title" < "$_rd_cache")
    if [ "$_rd_n" -eq 0 ]; then
      _rd_bad="${_rd_bad}secrets: cannot read $_rd_name (item $_rd_title in vault $_rd_vault)
"
    elif [ "$_rd_n" -gt 1 ]; then
      _rd_bad="${_rd_bad}secrets: more than one item is titled $_rd_title in vault $_rd_vault. Keep one.
"
    fi
  done <<EOF
$1
EOF
  [ -n "$_rd_bad" ] || secrets_die "op run stopped before the command started (exit $4)"
  printf '%s' "$_rd_bad" >&2
  exit 1
}

# secrets_refuse_guarded GUARDED-REFS PROJECT NAME TITLE: dies when a guarded ref has NAME, or
# points at TITLE in the project vault.
secrets_refuse_guarded() {
  _rg_titles=''
  while IFS=$secrets_tab read -r _rg_name _rg_vault _rg_title; do
    [ "$_rg_name" != "$3" ] || secrets_die "$3 is a guarded secret. Ask the owner to change it in 1Password."
    [ "$_rg_vault" != "$2" ] || _rg_titles="$_rg_titles$_rg_title
"
  done <<EOF
$1
EOF
  [ -z "$_rg_titles" ] || [ "$(printf '%s' "$_rg_titles" | secrets_title_count "$4")" = 0 ] ||
    secrets_die "$3 is a guarded secret. Ask the owner to change it in 1Password."
}

secrets_cmd_import() {
  _im_names_only=''
  while [ $# -gt 0 ]; do
    case $1 in
      --names-only) _im_names_only=1; shift ;;
      --) shift; break ;;
      -*) secrets_die "unknown option \"$1\". Use: secrets import [--names-only] FILE[:STAGE]..." ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || secrets_die "no env file. Use: secrets import [--names-only] FILE[:STAGE]..."
  secrets_env_check "$@"
  if [ -n "$_im_names_only" ]; then
    for _im_spec do
      _im_stage=$(secrets_stage_of "$_im_spec") || exit 1
      secrets_env_each "$(secrets_spec_file "$_im_spec")" secrets_import_show
    done
    return 0
  fi

  _im_root=$(secrets_repo_root) || exit 1
  _im_project=$(secrets_project "$_im_root") || exit 1
  _im_guarded=$(secrets_guarded_refs "$_im_root") || exit 1
  _im_plan=''
  for _im_spec do
    _im_file=$(secrets_spec_file "$_im_spec")
    _im_stage=$(secrets_stage_of "$_im_spec") || exit 1
    _im_count=0
    secrets_env_each "$_im_file" secrets_import_plan
    [ "$_im_count" -le 50 ] ||
      secrets_die "$_im_file has $_im_count names. import takes at most 50; use secrets setup --import."
  done
  _im_token=$(secrets_token "$_im_project") || exit 1
  OP_SERVICE_ACCOUNT_TOKEN=$_im_token
  export OP_SERVICE_ACCOUNT_TOKEN
  _im_titles=$(secrets_titles "$_im_project") || exit 1
  while IFS= read -r _im_title; do
    [ -z "$_im_title" ] || secrets_title_exists "$_im_titles" "$_im_title" "$_im_project" > /dev/null
  done <<EOF
$_im_plan
EOF

  _im_stored=''
  _im_skipped=''
  for _im_spec do
    _im_stage=$(secrets_stage_of "$_im_spec") || exit 1
    secrets_env_each "$(secrets_spec_file "$_im_spec")" secrets_import_put
  done
  printf 'secrets: stored in %s: %s%s\n' "$_im_project" "${_im_stored:-nothing}" \
    "${_im_skipped:+. Skipped (empty value): $_im_skipped}"
}

secrets_import_show() { # NAME VALUE
  if [ -z "$2" ]; then
    printf '%s  (empty, skipped)\n' "$1"
  else
    printf '%s  %s%s\n' "$1" "${_im_stage:-default}" "$(secrets_short_mark "$2")"
  fi
}

secrets_import_plan() { # NAME VALUE
  [ -n "$2" ] || return 0
  _ipl_title=$1${_im_stage:+.$_im_stage}
  secrets_refuse_guarded "$_im_guarded" "$_im_project" "$1" "$_ipl_title"
  _im_count=$((_im_count + 1))
  _im_plan="$_im_plan$_ipl_title
"
}

secrets_import_put() { # NAME VALUE
  if [ -z "$2" ]; then
    _im_skipped=${_im_skipped:+$_im_skipped, }$1
    return 0
  fi
  _iw_title=$1${_im_stage:+.$_im_stage}
  _iw_n=$(secrets_title_exists "$_im_titles" "$_iw_title" "$_im_project") || exit 1
  printf '%s' "$2" | secrets_item_put "$_im_project" "$_iw_title" '' "$_iw_n" || exit 1
  secrets_refs_set "$_im_root/$(secrets_refs_file "$_im_stage" 0)" "$1" "$_im_project" "$_iw_title"
  _im_stored=${_im_stored:+$_im_stored, }$_iw_title
}

secrets_cmd_add() {
  _ad_name=''
  _ad_stage=''
  while [ $# -gt 0 ]; do
    case $1 in
      --stage)
        [ $# -ge 2 ] || secrets_die "--stage needs a name"
        secrets_check stage "$2"
        _ad_stage=$2
        shift 2 ;;
      -*) secrets_die "unknown option \"$1\". Use: secrets add NAME [--stage NAME]" ;;
      *)
        [ -z "$_ad_name" ] || secrets_die "one name only. Use: secrets add NAME [--stage NAME]"
        _ad_name=$1
        shift ;;
    esac
  done
  [ -n "$_ad_name" ] || secrets_die "no name. Use: secrets add NAME [--stage NAME]"
  secrets_check name "$_ad_name"
  _ad_root=$(secrets_repo_root) || exit 1
  _ad_project=$(secrets_project "$_ad_root") || exit 1
  _ad_title=$_ad_name${_ad_stage:+.$_ad_stage}
  _ad_guarded=$(secrets_guarded_refs "$_ad_root") || exit 1
  secrets_refuse_guarded "$_ad_guarded" "$_ad_project" "$_ad_name" "$_ad_title"
  _ad_token=$(secrets_token "$_ad_project") || exit 1

  if [ -t 0 ]; then
    _ad_tty=$(stty -g)
    trap 'stty "$_ad_tty"' EXIT
    trap 'stty "$_ad_tty"; exit 130' INT
    trap 'stty "$_ad_tty"; exit 143' TERM
    printf 'secrets: value for %s (hidden): ' "$_ad_name" >&2
    stty -echo
    IFS= read -r _ad_value
    stty "$_ad_tty"
    trap - EXIT INT TERM
    printf '\n' >&2
  else
    _ad_value=$(cat)
  fi
  [ -n "$_ad_value" ] || secrets_die "the value for $_ad_name is empty. Nothing was stored."

  OP_SERVICE_ACCOUNT_TOKEN=$_ad_token
  export OP_SERVICE_ACCOUNT_TOKEN
  _ad_titles=$(secrets_titles "$_ad_project") || exit 1
  _ad_n=$(secrets_title_exists "$_ad_titles" "$_ad_title" "$_ad_project") || exit 1
  printf '%s' "$_ad_value" | secrets_item_put "$_ad_project" "$_ad_title" '' "$_ad_n" || exit 1
  secrets_refs_set "$_ad_root/$(secrets_refs_file "$_ad_stage" 0)" "$_ad_name" "$_ad_project" "$_ad_title"
  printf 'secrets: stored in %s: %s\n' "$_ad_project" "$_ad_title"
}

# secrets_quote ARG: ARG in single quotes for a shell, with each ' written as '\''.
secrets_quote() {
  _qt_out=''
  _qt_rest=$1
  while :; do
    case $_qt_rest in
      *\'*) _qt_out=$_qt_out${_qt_rest%%\'*}"'\\''"; _qt_rest=${_qt_rest#*\'} ;;
      *) break ;;
    esac
  done
  printf "'%s'\n" "$_qt_out$_qt_rest"
}

secrets_cmd_setup() {
  _su_usage='Use: secrets setup PROJECT [--import FILE[:STAGE]]... [--guard NAME,...] [--renew]'
  [ $# -gt 0 ] || secrets_die "no project. $_su_usage"
  case $1 in -*) secrets_die "no project. $_su_usage" ;; esac
  secrets_check project "$1"
  _su_project=$1
  shift
  _su_args=''
  _su_specs=''
  _su_guards=''
  while [ $# -gt 0 ]; do
    case $1 in
      --import)
        [ $# -ge 2 ] || secrets_die "--import needs a file. $_su_usage"
        case $2 in *'
'*) secrets_die "an import path cannot hold a newline" ;; esac
        _su_file=$(secrets_spec_file "$2")
        case $2 in *:*) _su_suffix=:${2##*:} ;; *) _su_suffix='' ;; esac
        case $_su_file in /*) ;; *) _su_file=$PWD/$_su_file ;; esac
        _su_real=$(realpath -- "$_su_file" 2>/dev/null) || _su_real=$_su_file
        if ! secrets_path_ok "$_su_file" || ! secrets_path_ok "$_su_real"; then
          secrets_die "an import path holds a character that setup does not accept"
        fi
        _su_specs="$_su_specs
$_su_file$_su_suffix"
        _su_args="$_su_args --import $(secrets_quote "$_su_file$_su_suffix")"
        shift ;;
      --guard)
        [ $# -ge 2 ] || secrets_die "--guard needs names. $_su_usage"
        case $2 in ,* | *, | *,,*) secrets_check name '' ;; esac
        _su_rest=$2,
        while [ -n "$_su_rest" ]; do
          _su_name=${_su_rest%%,*}
          _su_rest=${_su_rest#*,}
          secrets_check name "$_su_name"
          _su_guards="$_su_guards
$_su_name"
        done
        _su_args="$_su_args --guard $(secrets_quote "$2")"
        shift ;;
      --renew) _su_args="$_su_args --renew" ;;
      *) secrets_die "unknown option \"$1\". $_su_usage" ;;
    esac
    shift
  done
  secrets_setup_check

  _su_wait=${SECRETS_SETUP_WAIT:-900}
  case $_su_wait in '' | *[!0123456789]*) secrets_die "SECRETS_SETUP_WAIT must be a number of seconds" ;; esac
  _su_root=$(secrets_repo_root) || exit 1
  secrets_path_ok "$_su_root" || secrets_die "the repo path holds a character that setup does not accept"
  _su_dir=$(mktemp -d "${TMPDIR:-/tmp}/secrets-setup.XXXXXX") || secrets_die "cannot make a temp folder in ${TMPDIR:-/tmp}"
  trap 'rm -rf "$_su_dir"' EXIT
  trap 'rm -rf "$_su_dir"; exit 130' INT
  trap 'rm -rf "$_su_dir"; exit 143' TERM
  chmod 700 "$_su_dir" || exit 1
  _su_result=$_su_dir/result

  printf '#!/bin/sh\nexec %s %s %s %s%s\n' "$(secrets_quote "${secrets_dir%/*}/libexec/setup-window.sh")" \
    "$(secrets_quote "$_su_root")" "$(secrets_quote "$_su_result")" "$(secrets_quote "$_su_project")" \
    "$_su_args" > "$_su_dir/launch.command" || exit 1
  chmod 700 "$_su_dir/launch.command" || exit 1
  open -a Terminal "$_su_dir/launch.command" || secrets_die "cannot open a Terminal window"
  secrets_setup_result
}

# secrets_setup_check: parses the import files in _su_specs, and dies when a name in _su_guards
# is in none of them.
secrets_setup_check() {
  [ -z "$_su_specs" ] || {
    IFS='
'
    set -f
    # shellcheck disable=SC2086 # one word per line; globbing is off
    set -- $_su_specs
    set +f
    unset IFS
    secrets_env_check "$@"
    _su_names=''
    for _su_spec do
      secrets_env_each "$(secrets_spec_file "$_su_spec")" secrets_setup_name
    done
  }
  IFS='
'
  set -f
  # shellcheck disable=SC2086 # one word per line; globbing is off
  set -- $_su_guards
  set +f
  unset IFS
  for _su_name do
    case "
${_su_names-}" in
      *"
$_su_name
"*) ;;
      *) secrets_die "$_su_name is in no import file, so it cannot be guarded." ;;
    esac
  done
}

secrets_setup_name() { # NAME VALUE
  _su_names="$_su_names$1
"
}

# secrets_setup_result: waits up to _su_wait seconds for the window's file _su_result, then prints
# its summary lines: to stdout after "ok", or to stderr after "failed: ..." and exits 1.
secrets_setup_result() {
  _su_elapsed=0
  while [ ! -e "$_su_result" ]; do
    [ "$_su_elapsed" -lt "$_su_wait" ] || secrets_die "the setup window gave no result in $_su_wait seconds"
    sleep 2
    _su_elapsed=$((_su_elapsed + 2))
  done
  _su_status=''
  IFS= read -r _su_status < "$_su_result" || :
  case $_su_status in
    ok) _su_to=1 ;;
    'failed: '?*)
      printf 'secrets: setup failed: %s\n' "${_su_status#failed: }" >&2
      _su_to=2 ;;
    *) secrets_die "the setup window failed" ;;
  esac
  _su_n=0
  while IFS= read -r _su_text || [ -n "$_su_text" ]; do
    _su_n=$((_su_n + 1))
    [ "$_su_n" -eq 1 ] || printf '%s\n' "$_su_text" >&"$_su_to"
  done < "$_su_result"
  [ "$_su_to" -eq 1 ] || exit 1
}

# secrets_status_try CMD...: runs CMD in a subshell (it may exit). Sets _st_rc, _st_out and
# _st_err (the first stderr line, without "secrets: ").
secrets_status_try() {
  ("$@") >"$_st_dir/out" 2>"$_st_dir/err"
  _st_rc=$?
  _st_out=$(cat "$_st_dir/out")
  IFS= read -r _st_err < "$_st_dir/err" || :
  _st_err=${_st_err#secrets: }
}

secrets_status_ok() { printf 'secrets: ok: %s\n' "$1"; }

secrets_status_fail() {
  printf 'secrets: FAIL: %s\n' "$1"
  _st_bad=1
}

# secrets_status_titles VAULT PROJECT: sets _st_titles to the titles in VAULT. Returns 1, after
# one FAIL line for the vault, when it cannot be listed (also on every later call).
secrets_status_titles() {
  _stt_cache=$_st_dir/titles/$(secrets_lower "$1")
  if [ ! -e "$_stt_cache" ] && [ ! -e "$_stt_cache.fail" ]; then
    secrets_status_try secrets_titles "$1" "$2"
    if [ "$_st_rc" -eq 0 ]; then
      printf '%s\n' "$_st_out" > "$_stt_cache"
    else
      : > "$_stt_cache.fail"
      secrets_status_fail "cannot list vault $1: $_st_err"
    fi
  fi
  [ ! -e "$_stt_cache.fail" ] || return 1
  _st_titles=$(cat "$_stt_cache")
}

# secrets_status_ver_ok VERSION: succeeds when VERSION is 2.42.0 or later.
secrets_status_ver_ok() {
  _sv_ver=${1%%[!0123456789.]*}
  IFS=. read -r _sv_major _sv_minor _ <<EOF
$_sv_ver
EOF
  case ${_sv_major:-x}.${_sv_minor:-x} in *[!0123456789.]*) return 1 ;; esac
  [ "$_sv_major" -gt 2 ] || { [ "$_sv_major" -eq 2 ] && [ "$_sv_minor" -ge 42 ]; }
}

# secrets_status_ops: the path of each op on the PATH, once per real file.
secrets_status_ops() {
  _so_seen=''
  IFS=:
  set -f
  for _so_dir in $PATH; do
    [ -n "$_so_dir" ] && [ -f "$_so_dir/op" ] && [ -x "$_so_dir/op" ] || continue
    _so_real=$(realpath "$_so_dir/op") || continue
    case "
$_so_seen" in *"
$_so_real
"*) continue ;; esac
    _so_seen="$_so_seen$_so_real
"
    printf '%s\n' "$_so_dir/op"
  done
  set +f
  unset IFS
}

secrets_cmd_status() {
  [ $# -eq 0 ] || secrets_die "status takes no arguments. Use: secrets status"
  _st_bad=0
  _st_dir=$(mktemp -d "${TMPDIR:-/tmp}/secrets-status.XXXXXX") || secrets_die "cannot make a temp folder in ${TMPDIR:-/tmp}"
  trap 'rm -rf "$_st_dir"' EXIT
  trap 'rm -rf "$_st_dir"; exit 130' INT
  trap 'rm -rf "$_st_dir"; exit 143' TERM
  mkdir "$_st_dir/titles" || exit 1

  _st_use_op=1
  if _st_ver=$(op --version 2>/dev/null) && [ -n "$_st_ver" ]; then
    if secrets_status_ver_ok "$_st_ver"; then
      secrets_status_ok "op $_st_ver (2.42.0 or later is needed)"
    else
      secrets_status_fail "op $_st_ver is older than 2.42.0. Run: brew upgrade 1password-cli"
    fi
  else
    secrets_status_fail "op is not on the PATH. Run: brew install 1password-cli"
    _st_use_op=0
  fi
  _st_ops=$(secrets_status_ops)
  _st_n=$(printf '%s\n' "$_st_ops" | grep -c .)
  if [ "$_st_n" -gt 1 ]; then
    secrets_status_fail "more than one op on the PATH: $(printf '%s\n' "$_st_ops" | tr '\n' ' ')Keep the Homebrew one."
  elif [ "$_st_n" -eq 1 ]; then
    secrets_status_ok "one op on the PATH: $_st_ops"
  fi
  if command -v jq >/dev/null; then
    secrets_status_ok "jq is on the PATH"
  else
    secrets_status_fail "jq is not on the PATH. Run: brew install jq"
    _st_use_op=0
  fi
  if [ "${TERM_PROGRAM-}" = Apple_Terminal ]; then
    secrets_status_ok "this is Terminal.app, which needs the 1Password folder permission. Not checked here."
  elif ls "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/" >/dev/null 2>&1; then
    secrets_status_fail "this app can list the 1Password Group Containers folder, so it holds the permission that only Terminal.app needs. Turn \"Data shared by 1Password and affiliated apps\" off for it in System Settings > Privacy & Security > Files & Folders."
  else
    secrets_status_ok "this app cannot list the 1Password Group Containers folder, as intended"
  fi
  printf 'secrets: not checked here: the 1Password app setting "Integrate with 1Password CLI", and Terminal.app with "Data shared by 1Password and affiliated apps" on. The setup window checks them.\n'

  _st_root=$(secrets_repo_root) || exit 1
  secrets_status_try secrets_project "$_st_root"
  if [ "$_st_rc" -ne 0 ]; then
    secrets_status_fail "$_st_err"
    printf 'secrets: not checked: the refs, the guarded names and agent-shared, which need the project name.\n'
    exit 1
  fi
  _st_project=$_st_out

  # Not secrets_status_try: it writes stdout, here the token, to a file.
  _st_token=$(secrets_token "$_st_project" 2>"$_st_dir/err")
  _st_rc=$?
  if [ "$_st_rc" -ne 0 ]; then
    IFS= read -r _st_err < "$_st_dir/err" || :
    secrets_status_fail "${_st_err#secrets: }"
    _st_use_op=0
  elif [ "$_st_use_op" -eq 1 ]; then
    OP_SERVICE_ACCOUNT_TOKEN=$_st_token
    export OP_SERVICE_ACCOUNT_TOKEN
    secrets_status_ok "the Keychain item op-sa-$_st_project holds a token"
  fi
  if [ "$_st_use_op" -ne 1 ]; then
    printf 'secrets: not checked: the refs, the guarded names and agent-shared, which need op, jq and the token.\n'
    exit 1
  fi

  for _st_f in "$_st_root/.secrets-refs" "$_st_root"/.secrets-refs.*; do
    [ -f "$_st_f" ] || [ "$_st_f" = "$_st_root/.secrets-refs" ] || continue
    _st_mark=''
    case $_st_f in *.guarded) _st_mark=' (guarded: Claude Code asks before use)' ;; esac
    secrets_status_try secrets_refs_read "$_st_f"
    if [ "$_st_rc" -ne 0 ]; then
      secrets_status_fail "$_st_err"
      continue
    fi
    _st_refs=$_st_out
    while IFS=$secrets_tab read -r _st_name _st_vault _st_title; do
      [ -n "$_st_name" ] || continue
      if ! secrets_status_titles "$_st_vault" "$_st_project"; then
        printf 'secrets: %s not checked\n' "$_st_name"
        continue
      fi
      _st_count=$(printf '%s\n' "$_st_titles" | secrets_title_count "$_st_title")
      if [ "$_st_count" -eq 0 ]; then
        printf 'secrets: %s MISSING (item %s in vault %s)\n' "$_st_name" "$_st_title" "$_st_vault"
        _st_bad=1
      elif [ "$_st_count" -gt 1 ]; then
        secrets_status_fail "more than one item is titled $_st_title in vault $_st_vault. Keep one."
      else
        printf 'secrets: %s readable%s\n' "$_st_name" "$_st_mark"
      fi
    done <<EOF
$_st_refs
EOF
  done

  if secrets_status_titles agent-shared "$_st_project"; then
    secrets_status_ok "agent-shared readable"
  fi
  exit "$_st_bad"
}

case ${1-} in
  setup | run | import | add | status)
    secrets_sub=$1
    shift
    "secrets_cmd_$secrets_sub" "$@" ;;
  *) secrets_die "unknown subcommand \"${1-}\". Use: setup, run, import, add, status" ;;
esac
