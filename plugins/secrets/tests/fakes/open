#!/bin/sh
# Fake macOS open, only `open -a Terminal FILE`. It appends its argv to $FAKE_OPEN_DIR/argv.log.
# It runs FILE at once (not in a new window), from $HOME as Terminal does, with stdin from
# $FAKE_OPEN_STDIN (unset: one empty line, as one Enter; set but empty: EOF), and appends
# FILE's stdout and stderr to $FAKE_OPEN_DIR/window.log. FAKE_OPEN_MODE=ignore: only log. FAKE_OPEN_MODE=async: run FILE in the
# background and return at once, as the real open does.

CALLER_PATH=$PATH
PATH=/usr/bin:/bin:/usr/sbin:/sbin
D=${FAKE_OPEN_DIR:?FAKE_OPEN_DIR is not set}
mkdir -p "$D" || exit 2
printf '%s\n' "$*" >> "$D/argv.log"

if [ $# -ne 3 ] || [ "$1" != -a ] || [ "$2" != Terminal ]; then
  printf 'fake open: not modeled: open %s\n' "$*" >&2
  exit 2
fi
[ "${FAKE_OPEN_MODE-}" != ignore ] || exit 0
case $3 in /*) file=$3 ;; *) file=$PWD/$3 ;; esac
[ -f "$file" ] || { printf 'The file %s does not exist.\n' "$file" >&2; exit 1; }
[ -x "$file" ] || { printf 'fake open: %s has no execute bit, so Terminal cannot run it\n' "$file" >&2; exit 1; }

cd "$HOME" || exit 1
PATH=$CALLER_PATH
run_window() {
  if [ -n "${FAKE_OPEN_STDIN+x}" ]; then
    printf '%s' "$FAKE_OPEN_STDIN"
  else
    echo
  fi | "$file" >> "$D/window.log" 2>&1
}
if [ "${FAKE_OPEN_MODE-}" = async ]; then
  run_window </dev/null >/dev/null 2>&1 &
else
  run_window
fi
exit 0
