#!/bin/sh
# Fake macOS security, generic passwords only. $FAKE_SEC_DIR/items/<service> holds the password
# (the account is not modeled). Every call appends its argv, never its stdin, to $FAKE_SEC_DIR/argv.log.
# Knob: FAKE_SEC_FAIL=<code> makes find-generic-password fail with that exit code.
# With -i, each stdin line is one command, split at white space, with double quotes stripped.

PATH=/usr/bin:/bin:/usr/sbin:/sbin
D=${FAKE_SEC_DIR:?FAKE_SEC_DIR is not set}
mkdir -p "$D/items" || exit 2
printf '%s\n' "$*" >> "$D/argv.log"

unmodeled() { printf 'fake security: not modeled: %s\n' "$1" >&2; return 2; }
not_found() {
  echo 'security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain.' >&2
  return 44
}

one() { # COMMAND ARGS...
  _cmd=${1-}
  [ $# -eq 0 ] || shift
  _svc='' _pw='' _pw_set='' _only='' _update=''
  while [ $# -gt 0 ]; do
    case $_cmd:$1 in
      *:-a | *:-s | add-generic-password:-w)
        [ $# -ge 2 ] || { unmodeled "$1 without a value"; return; }
        case $1 in -s) _svc=$2 ;; -w) _pw=$2; _pw_set=1 ;; esac
        shift ;;
      find-generic-password:-w) _only=1 ;;
      add-generic-password:-U) _update=1 ;;
      *) unmodeled "$_cmd $1"; return ;;
    esac
    shift
  done
  case $_svc in '' | */* | .*) unmodeled "$_cmd with service [$_svc]"; return ;; esac
  _f=$D/items/$_svc
  case $_cmd in
    find-generic-password)
      if [ -n "${FAKE_SEC_FAIL-}" ]; then
        echo 'security: fake failure (FAKE_SEC_FAIL)' >&2
        return "$FAKE_SEC_FAIL"
      fi
      [ -f "$_f" ] || { not_found; return; }
      if [ -n "$_only" ]; then
        cat "$_f"
        echo
      else
        printf 'class: "genp"\nattributes:\n    "svce"<blob>="%s"\n' "$_svc"
      fi ;;
    add-generic-password)
      [ -n "$_pw_set" ] || { unmodeled "add-generic-password without -w PASSWORD"; return; }
      if [ -f "$_f" ] && [ -z "$_update" ]; then
        echo 'security: SecKeychainItemCreateFromContent (<default>): The specified item already exists in the keychain.' >&2
        return 45
      fi
      printf '%s' "$_pw" > "$_f" ;;
    delete-generic-password)
      [ -f "$_f" ] || { not_found; return; }
      rm -f "$_f"
      echo 'password has been deleted.' ;;
    *) unmodeled "$_cmd" ;;
  esac
}

if [ "${1-}" = -i ]; then
  rc=0
  while IFS= read -r line || [ -n "$line" ]; do
    set -f
    # shellcheck disable=SC2086 # split the line into words, as security -i does
    set -- $line
    set +f
    [ $# -gt 0 ] || continue
    n=$#
    for w do
      w=${w#\"}
      set -- "$@" "${w%\"}"
    done
    shift "$n"
    one "$@" || rc=1
  done
  exit "$rc"
fi
one "$@"
