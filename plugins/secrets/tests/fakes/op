#!/bin/sh
# Fake 1Password CLI. Its error texts are the ones the real op 2.42.0 printed in the probes,
# except these invented ones: the rate-limit text (from the docs), the "executable file not
# found" line of run, the "error initializing client: " prefix on run's invalid-token text, the
# "isn't a vault" text under run and read, the "no such file or directory" text for a missing
# env file, and the item edit and item delete texts (copied from read and run).
#
# State in $FAKE_OP_DIR:
#   vaults/<vault>/<title>.value    the password field, as stored (no newline added)
#   vaults/<vault>/<title>.tags     comma-separated tags, if any
#   vaults/<vault>/<title>.version  the item version, when not 1
#   vaults/<vault>/<title>.copies   the number of items with this title, when more than 1
#                                   (the copies share the value and the tags)
#   tokens/<token>                  one vault per line that the token reads; <vault>:w also writes
#   argv.log                        one call per line, arguments joined by spaces
# Knobs: FAKE_OP_VERSION (default 2.42.0), FAKE_OP_ACCOUNTS (default 1),
#   FAKE_OP_FAIL=unreachable|ratelimit (every call but --version fails),
#   FAKE_OP_FAIL_MATCH=<text> (only calls whose argv holds <text> fail; default kind unreachable).
# Without OP_SERVICE_ACCOUNT_TOKEN the caller is the owner: every vault, read and write.
# account list, vault list, vault get and item list need --format json (the real op prints a table).

CALLER_PATH=$PATH
PATH=/usr/bin:/bin:/usr/sbin:/sbin
D=${FAKE_OP_DIR:?FAKE_OP_DIR is not set}
mkdir -p "$D/vaults" "$D/tokens" || exit 2
printf '%s\n' "$*" >> "$D/argv.log"

DATE='2026-01-01T00:00:00Z'
PERM='unable to process line 1: Permission: (101) You do not have permission to perform this action'

err() { printf '[ERROR] 2026/01/01 00:00:00 %s\n' "$1" >&2; }
die() { err "$1"; exit "${2:-1}"; }
unmodeled() { printf 'fake op: not modeled: %s\n' "$1" >&2; exit 2; }
lower() { printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]'; }
no_vault() { die "\"$1\" isn't a vault in this account. Specify the vault with its ID or name."; }

if [ "${1-}" = --version ]; then
  printf '%s\n' "${FAKE_OP_VERSION:-2.42.0}"
  exit 0
fi

init=
[ "${1-}" != run ] || init='error initializing client: '

fail=${FAKE_OP_FAIL-}
if [ -n "${FAKE_OP_FAIL_MATCH-}" ]; then
  case "$*" in *"$FAKE_OP_FAIL_MATCH"*) fail=${fail:-unreachable} ;; *) fail= ;; esac
fi
case $fail in
  '') ;;
  unreachable) die "${init}Get \"/api/v2/account/keysets\": proxyconnect tcp: dial tcp 127.0.0.1:9: connect: connection refused" ;;
  ratelimit) die '(429) Too Many Requests: You have reached the number of requests this service account is allowed to make. Please retry in 59 minutes.' ;;
  *) unmodeled "FAKE_OP_FAIL=$fail" ;;
esac

tokfile=
if [ -n "${OP_SERVICE_ACCOUNT_TOKEN-}" ]; then
  case $OP_SERVICE_ACCOUNT_TOKEN in */* | .*) ;; *) tokfile=$D/tokens/$OP_SERVICE_ACCOUNT_TOKEN ;; esac
  if [ -z "$tokfile" ] || [ ! -f "$tokfile" ]; then
    die "${init}failed to DecodeSACredentials: invalid character '\\u008a' looking for beginning of value" 9
  fi
fi

can() { # VAULT MODE: MODE "" reads, ":w" writes
  [ -n "$tokfile" ] || return 0
  _can_want=$(lower "$1")$2
  while IFS= read -r _can_line || [ -n "$_can_line" ]; do
    [ -n "$2" ] || _can_line=${_can_line%:w}
    [ "$(lower "$_can_line")" != "$_can_want" ] || return 0
  done < "$tokfile"
  return 1
}

# find_vault NAME: prints the stored name of the vault that NAME matches in any case,
# when the caller can read it.
find_vault() {
  _fv_want=$(lower "$1")
  for _fv_dir in "$D"/vaults/*; do
    [ -d "$_fv_dir" ] || continue
    _fv_name=${_fv_dir##*/}
    [ "$(lower "$_fv_name")" = "$_fv_want" ] || continue
    can "$_fv_name" "" || return 1
    printf '%s\n' "$_fv_name"
    return 0
  done
  return 1
}

copies() { # VAULT TITLE
  if [ ! -f "$D/vaults/$1/$2.value" ]; then echo 0
  elif [ -f "$D/vaults/$1/$2.copies" ]; then cat "$D/vaults/$1/$2.copies"
  else echo 1
  fi
}

vault_id() { printf 'vault-%s\n' "$(lower "$1")"; }
item_id() { printf 'item-%s-%s-%s\n' "$(lower "$1")" "$2" "$3"; }

dup_lines() { # VAULT TITLE
  _dl_i=1
  _dl_n=$(copies "$1" "$2")
  while [ "$_dl_i" -le "$_dl_n" ]; do
    printf '\t* for the item "%s" in vault %s: %s\n' "$2" "$1" "$(item_id "$1" "$2" "$_dl_i")" >&2
    _dl_i=$((_dl_i + 1))
  done
}

# one_item VAULT GIVEN-VAULT TITLE: dies unless exactly one item has TITLE.
one_item() {
  _oi_n=$(copies "$1" "$3")
  [ "$_oi_n" -ne 0 ] || die "\"$3\" isn't an item in the \"$2\" vault. Specify the item with its UUID, name, or domain."
  if [ "$_oi_n" -gt 1 ]; then
    err "More than one item matches \"$3\". Try again and specify the item by its ID: "
    dup_lines "$1" "$3"
    exit 1
  fi
}

check_file_name() { # a title, vault or service-account name; each becomes a file name
  case $1 in '' | */* | .*) unmodeled "name [$1]" ;; esac
}

vault_json() { # VAULT
  _vj_n=0
  for _vj_f in "$D/vaults/$1"/*.value; do
    [ -f "$_vj_f" ] || continue
    _vj_t=${_vj_f##*/}
    _vj_n=$((_vj_n + $(copies "$1" "${_vj_t%.value}")))
  done
  jq -n --arg id "$(vault_id "$1")" --arg name "$1" --arg date "$DATE" --argjson items "$_vj_n" \
    '{id: $id, name: $name, content_version: 1, created_at: $date, updated_at: $date, items: $items}'
}

# item_json VAULT TITLE COPY [full]: "full" adds the fields, value included, as create and edit print them.
item_json() {
  _ij_f=$D/vaults/$1/$2
  _ij_tags=
  [ ! -f "$_ij_f.tags" ] || _ij_tags=$(cat "$_ij_f.tags")
  _ij_ver=1
  [ ! -f "$_ij_f.version" ] || _ij_ver=$(cat "$_ij_f.version")
  jq -n --arg id "$(item_id "$1" "$2" "$3")" --arg title "$2" --argjson version "$_ij_ver" \
    --arg vid "$(vault_id "$1")" --arg vname "$1" --arg date "$DATE" --arg tags "$_ij_tags" \
    --arg full "${4-}" --rawfile value "$_ij_f.value" \
    '{id: $id, title: $title, version: $version, vault: {id: $vid, name: $vname},
      category: "PASSWORD", last_edited_by: "FAKEUSERID", created_at: $date, updated_at: $date,
      additional_information: ""}
     + (if $tags == "" then {} else {tags: ($tags | split(","))} end)
     + (if $full == "" then {} else {fields: [{id: "password", type: "CONCEALED", purpose: "PASSWORD",
          label: "password", value: $value}]} end)'
}

has_tag() { # VAULT TITLE WANTED (comma-separated; any one matches)
  [ -f "$D/vaults/$1/$2.tags" ] || return 1
  _ht_have=,$(cat "$D/vaults/$1/$2.tags"),
  _ht_ifs=$IFS
  IFS=,
  for _ht_t in $3; do
    case $_ht_have in *",$_ht_t,"*) IFS=$_ht_ifs; return 0 ;; esac
  done
  IFS=$_ht_ifs
  return 1
}

list_items() { # VAULT TAG-FILTER
  for _li_f in "$D/vaults/$1"/*.value; do
    [ -f "$_li_f" ] || continue
    _li_t=${_li_f##*/}
    _li_t=${_li_t%.value}
    if [ -n "$2" ]; then has_tag "$1" "$_li_t" "$2" || continue; fi
    _li_n=$(copies "$1" "$_li_t")
    _li_i=1
    while [ "$_li_i" -le "$_li_n" ]; do
      item_json "$1" "$_li_t" "$_li_i"
      _li_i=$((_li_i + 1))
    done
  done
}

password_of() { # reads the item JSON on stdin; prints the password value as stored
  jq -j '.fields[] | select(.id == "password") | .value'
}

has_password() { # JSON
  printf '%s' "$1" | jq -e '[.fields[]? | select(.id == "password")] | length == 1' >/dev/null 2>&1
}

# resolve REF: prints the value, as `op run` and `op read` resolve op://VAULT/TITLE/password.
resolve() {
  case $1 in op://*/*/*) ;; *) unmodeled "reference [$1]" ;; esac
  _rs_rest=${1#op://}
  _rs_vault=${_rs_rest%%/*}
  _rs_rest=${_rs_rest#*/}
  _rs_title=${_rs_rest%%/*}
  [ "${_rs_rest#*/}" = password ] || unmodeled "reference [$1]: only the password field"
  if [ "$cmd" = read ]; then
    _rs_pre="could not read secret '$1': could not get item $_rs_vault/$_rs_title: "
    _rs_missing="\"$_rs_title\" isn't an item in the \"$_rs_vault\" vault. Specify the item with its UUID, name, or domain."
  else
    _rs_pre="could not resolve item UUID for item $_rs_title: "
    _rs_missing="could not find item $_rs_title in vault $(vault_id "$_rs_vault")"
  fi
  _rs_v=$(find_vault "$_rs_vault") ||
    die "${_rs_pre}\"$_rs_vault\" isn't a vault in this account. Specify the vault with its ID or name."
  _rs_n=$(copies "$_rs_v" "$_rs_title")
  [ "$_rs_n" -ne 0 ] || die "$_rs_pre$_rs_missing"
  if [ "$_rs_n" -gt 1 ]; then
    err "${_rs_pre}More than one item matches \"$_rs_title\". Try again and specify the item by its ID: "
    dup_lines "$_rs_v" "$_rs_title"
    exit 1
  fi
  cat "$D/vaults/$_rs_v/$_rs_title.value"
}

case ${1-} in
  read | run | signout) cmd=$1; shift ;;
  account | vault | item | service-account) cmd="$1 ${2-}"; shift; [ $# -eq 0 ] || shift ;;
  *) unmodeled "op $*" ;;
esac

vault='' vaults='' tags='' tags_set='' raw='' no_newline='' files='' arg='' stdin_dash='' format_json=''
while [ $# -gt 0 ]; do
  case $1 in
    --) shift; break ;;
    --vault | --tags | --format | --env-file | --expires-in | --account)
      [ $# -ge 2 ] || unmodeled "$1 without a value"
      case $1 in
        --vault) vault=$2; vaults="$vaults$2
" ;;
        --tags) tags=$2; tags_set=1 ;;
        --format) [ "$2" = json ] || unmodeled "--format $2"; format_json=1 ;;
        --env-file) files="$files$2
" ;;
      esac
      shift ;;
    --format=json) format_json=1 ;;
    --cache | --cache=* | --reveal | --archive) ;;
    --raw) raw=1 ;;
    -n | --no-newline) no_newline=1 ;;
    -) stdin_dash=1 ;;
    -*) unmodeled "flag $1 for $cmd" ;;
    *) [ -z "$arg" ] || unmodeled "a second argument [$1] for $cmd"; arg=$1 ;;
  esac
  shift
done
[ "$cmd" = run ] || [ $# -eq 0 ] || unmodeled "arguments after -- for $cmd"
case $cmd in
  'account list' | 'vault list' | 'vault get' | 'item list')
    [ -n "$format_json" ] || unmodeled "$cmd without --format json (the real op prints a table)" ;;
esac

case $cmd in
  'account list')
    _n=${FAKE_OP_ACCOUNTS:-1}
    _i=1
    while [ "$_i" -le "$_n" ]; do
      jq -n --arg i "$_i" '{url: ("account" + $i + ".example.invalid"), email: ("owner" + $i + "@example.invalid"),
        user_uuid: ("FAKEUSER" + $i), account_uuid: ("FAKEACCOUNT" + $i)}'
      _i=$((_i + 1))
    done | jq -s . ;;

  'vault list')
    for _dir in "$D"/vaults/*; do
      [ -d "$_dir" ] || continue
      can "${_dir##*/}" "" || continue
      vault_json "${_dir##*/}"
    done | jq -s . ;;

  'vault get')
    V=$(find_vault "$arg") || no_vault "$arg"
    vault_json "$V" ;;

  'vault create')
    [ -z "$tokfile" ] || die "$PERM"
    check_file_name "$arg"
    ! find_vault "$arg" >/dev/null || unmodeled "vault create [$arg]: it exists (the real op makes a second vault)"
    mkdir "$D/vaults/$arg" || exit 1
    vault_json "$arg" ;;

  'item list')
    if [ -n "$vault" ]; then
      V=$(find_vault "$vault") || no_vault "$vault"
      list_items "$V" "$tags" | jq -s .
    else
      for _dir in "$D"/vaults/*; do
        [ -d "$_dir" ] || continue
        can "${_dir##*/}" "" || continue
        list_items "${_dir##*/}" "$tags"
      done | jq -s .
    fi ;;

  'item create')
    [ -n "$vault" ] || unmodeled "item create without --vault"
    [ -n "$stdin_dash" ] || unmodeled "item create without - (the JSON on stdin)"
    V=$(find_vault "$vault") || no_vault "$vault"
    can "$V" :w || die "$PERM"
    json=$(cat)
    T=$(printf '%s' "$json" | jq -er '.title') || unmodeled "item create: no title in the JSON"
    check_file_name "$T"
    has_password "$json" || unmodeled "item create: no password field in the JSON"
    F=$D/vaults/$V/$T
    N=$(copies "$V" "$T")
    if [ "$N" -eq 0 ]; then
      printf '%s' "$json" | password_of > "$F.value"
      [ -z "$tags_set" ] || printf '%s\n' "$tags" > "$F.tags"
    else
      printf '%s\n' $((N + 1)) > "$F.copies"
    fi
    item_json "$V" "$T" $((N + 1)) full ;;

  'item edit')
    if [ -z "$arg" ] || [ -z "$vault" ]; then unmodeled "item edit without TITLE and --vault"; fi
    V=$(find_vault "$vault") || no_vault "$vault"
    one_item "$V" "$vault" "$arg"
    can "$V" :w || die "$PERM"
    F=$D/vaults/$V/$arg
    json=$(cat)
    if [ -n "$json" ]; then
      T=$(printf '%s' "$json" | jq -r '.title // empty') || unmodeled "item edit: stdin is not JSON"
      [ -z "$T" ] || [ "$T" = "$arg" ] || unmodeled "item edit: a new title"
      ! has_password "$json" || printf '%s' "$json" | password_of > "$F.value"
    fi
    [ -z "$tags_set" ] || printf '%s\n' "$tags" > "$F.tags"
    _ver=1
    [ ! -f "$F.version" ] || _ver=$(cat "$F.version")
    printf '%s\n' $((_ver + 1)) > "$F.version"
    item_json "$V" "$arg" 1 full ;;

  'item delete')
    if [ -z "$arg" ] || [ -z "$vault" ]; then unmodeled "item delete without TITLE and --vault"; fi
    V=$(find_vault "$vault") || no_vault "$vault"
    one_item "$V" "$vault" "$arg"
    can "$V" :w || die "$PERM"
    rm -f "$D/vaults/$V/$arg.value" "$D/vaults/$V/$arg.tags" "$D/vaults/$V/$arg.version" "$D/vaults/$V/$arg.copies" ;;

  read)
    [ -n "$arg" ] || unmodeled "read without a reference"
    value=$(resolve "$arg" && printf x) || exit 1
    printf '%s' "${value%x}"
    [ -n "$no_newline" ] || echo ;;

  'service-account create')
    [ -z "$tokfile" ] || die "$PERM"
    [ -n "$raw" ] || unmodeled "service-account create without --raw"
    check_file_name "$arg"
    lines=
    while IFS= read -r spec; do
      [ -n "$spec" ] || continue
      sv=${spec%%:*}
      find_vault "$sv" >/dev/null || no_vault "$sv"
      case $spec in *:*write_items*) lines="$lines$sv:w
" ;; *) lines="$lines$sv
" ;; esac
    done <<EOF
$vaults
EOF
    [ -n "$lines" ] || unmodeled "service-account create without --vault"
    printf '%s' "$lines" > "$D/tokens/ops_fake_$arg"
    printf 'ops_fake_%s\n' "$arg" ;;

  signout) ;;

  run)
    [ $# -gt 0 ] || unmodeled "run without -- CMD"
    [ -n "$files" ] || unmodeled "run without --env-file"
    _count=0
    while IFS= read -r _file; do
      [ -n "$_file" ] || continue
      [ -f "$_file" ] || die "${init}open $_file: no such file or directory"
      while IFS= read -r _line || [ -n "$_line" ]; do
        _trim=${_line#"${_line%%[! 	]*}"}
        case $_trim in '' | '#'*) continue ;; esac
        _name=${_line%%=*}
        [ "$_name" != "$_line" ] || unmodeled "run: env line without ="
        case $_name in '' | [!A-Za-z_]* | *[!A-Za-z0-9_]*) unmodeled "run: env name [$_name]" ;; esac
        _value=${_line#*=}
        case $_value in op://*) _value=$(resolve "$_value" && printf x) || exit 1; _value=${_value%x} ;; esac
        _count=$((_count + 1))
        eval "_n_$_count=\$_name _v_$_count=\$_value"
      done < "$_file"
    done <<EOF
$files
EOF
    PERL=$(command -v perl) || unmodeled "run needs perl"
    PATH=$CALLER_PATH
    _k=1
    while [ "$_k" -le "$_count" ]; do
      eval "export \"\$_n_$_k=\$_v_$_k\""
      _k=$((_k + 1))
    done
    # The real op run exits 255 when its child dies from a signal; a shell cannot tell
    # that from exit 129-255, so perl waits for the child.
    # shellcheck disable=SC2016 # perl code, not shell
    exec "$PERL" -e '
      my $rc = system { $ARGV[0] } @ARGV;
      if ($rc == -1) {
        print STDERR "[ERROR] 2026/01/01 00:00:00 exec: \"$ARGV[0]\": executable file not found in \$PATH\n";
        exit 1;
      }
      exit(($? & 127) ? 255 : ($? >> 8));
    ' -- "$@" ;;

  *) unmodeled "op $cmd" ;;
esac
