#!/bin/sh
# Test shim: appends "<tool> <args>" to $SHIM_LOG, then runs the real tool from the PATH
# without this folder. The tests read the log to prove that no value is in an argument.

tool=${0##*/}
here=$(cd "${0%/*}" && pwd -P) || exit 127
printf '%s %s\n' "$tool" "$*" >> "${SHIM_LOG:-/dev/null}"
rest=
set -f
IFS=:
for dir in $PATH; do
  [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$here" ] || rest=${rest:+$rest:}$dir
done
unset IFS
set +f
PATH=$rest
exec "$tool" "$@"
